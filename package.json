{
  "name": "firefly",
  "version": "0.1.0",
  "description": "Comprehensive financial independence and retirement planning application",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npm run build && electron .",
    "build": "tsc && cd src/renderer && tsc && cp index.html ../../dist/renderer/",
    "test": "npm run build && cucumber-js --require-module ts-node/register --require 'tests/steps/*.ts' features/",
    "test:unit": "jest",
    "lint": "eslint src/ --ext .ts",
    "package": "electron-builder"
  },
  "keywords": [
    "financial",
    "planning",
    "FIRE",
    "retirement",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  },
  "build": {
    "appId": "com.firefly.app",
    "productName": "Firefly",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "models/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    }
  }
}
