{
  "name": "firefly",
  "displayName": "Firefly Planner",
  "version": "0.1.0",
  "description": "Financial independence and retirement planning desktop application.",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run copy:assets",
    "copy:assets": "copyfiles -u 1 src/renderer/**/* dist/renderer",
    "start": "npm run build && electron .",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "acceptance": "cucumber-js --profile default"
  },
  "keywords": [
    "financial",
    "retirement",
    "planning",
    "electron"
  ],
  "author": "Firefly Contributors",
  "license": "MIT",
  "devDependencies": {
  "@cucumber/cucumber": "^11.2.0",
    "@types/node": "^22.7.4",
  "@typescript-eslint/eslint-plugin": "^7.18.0",
  "@typescript-eslint/parser": "^7.18.0",
    "copyfiles": "^2.4.1",
  "eslint": "^8.57.0",
    "rimraf": "^5.0.5",
  "ts-node": "^10.9.2",
  "typescript": "~5.5.4",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "electron": "^29.3.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
